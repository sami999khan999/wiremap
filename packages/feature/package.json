    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "jsdom": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "dependencies": {
    "@loadbearing/content": "workspace:*",
    "@loadbearing/contracts": "workspace:*",
    "@loadbearing/errors": "workspace:*",
    "@loadbearing/permissions": "workspace:*",
    "@loadbearing/query": "workspace:*",
    "@loadbearing/ui": "workspace:*"
