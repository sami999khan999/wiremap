{
  "name": "@loadbearing/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./src/style/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@loadbearing/permissions": "workspace:*",
    "@loadbearing/tsconfig": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "jsdom": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@loadbearing/asset": "workspace:*",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "uqr": "catalog:"
  },
  "sideEffects": [
    "*.css"
  ]
}
