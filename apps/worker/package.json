{
  "name": "@loadbearing/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@loadbearing/application": "workspace:*",
    "@loadbearing/composition": "workspace:*",
    "@loadbearing/contracts": "workspace:*",
    "@loadbearing/infrastructure": "workspace:*",
    "@loadbearing/permissions": "workspace:*",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loadbearing/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
