{
  "name": "@loadbearing/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js dev",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke": "vitest run -c vitest.smoke.config.ts",
    "clean": "rimraf dist .output .nitro .tanstack",
    "start": "node --env-file-if-exists=../../.env cluster.mjs"
  },
  "dependencies": {
    "@loadbearing/api-client": "workspace:*",
    "@loadbearing/api-server": "workspace:*",
    "@loadbearing/application": "workspace:*",
    "@loadbearing/composition": "workspace:*",
    "@loadbearing/content": "workspace:*",
    "@loadbearing/contracts": "workspace:*",
    "@loadbearing/errors": "workspace:*",
    "@loadbearing/feature": "workspace:*",
    "@loadbearing/observability": "workspace:*",
    "@loadbearing/permissions": "workspace:*",
    "@loadbearing/query": "workspace:*",
    "@loadbearing/ui": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@xyflow/react": "catalog:",
    "elkjs": "catalog:",
    "nitro": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loadbearing/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-react": "catalog:",
    "pg": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
