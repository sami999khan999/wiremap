# This file is the only one. Both apps, every script above `src/`, the test harnesses and
# `docker compose` all read it — see docs/setup/02-repo-skeleton.md.
#
# Every host port is the well-known port with a `4` in front: Postgres 5432 is published
# on 45432, Redis 6379 on 46379. The container-side port is unchanged, so `postgres:5432`
# from inside the compose network still reads as it always did. The prefix exists so this
# stack never fights another one on the same machine for 5432; the kit wiremap came from
# keeps 2xxxx. A `*_PORT` key and the URL beside it are edited together, and
# `check:architecture` §27 fails the build if they ever disagree.

# ── Postgres ─────────────────────────────────────────────
# What `docker compose` publishes.
POSTGRES_PORT=45432
# Straight at Postgres. The code is written as if pgBouncer sat in front in transaction
# mode, so adding one is this line and compose — docs/scale/pgbouncer.md.
DATABASE_URL=postgres://ratchet:ratchet@localhost:45432/ratchet
# The same server, no pooler. Migrations, the seed, drizzle-kit and the archive's
# `DETACH ... CONCURRENTLY` use this one — DDL a transaction pooler cannot carry.
DATABASE_DIRECT_URL=postgres://ratchet:ratchet@localhost:45432/ratchet
# Node 0's streaming standby. Lite runs none — docs/scale/read-replica.md. Present, the
# worker's batch reads use it while the platform switch is on and it has caught up.
# DATABASE_REPLICA_URL=postgres://ratchet:ratchet@localhost:45434/ratchet
# Per process, not per cluster. Count your replicas against pgBouncer's DEFAULT_POOL_SIZE
# and Postgres's max_connections — see docs/scale/pgbouncer.md.
# Twenty because that is what the worker's shipped consumers sum to, and a default that
# warns about itself on every boot is a warning people stop reading. Behind the pooler
# in transaction mode these are client connections, not backend ones.
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# Without this an unreachable Postgres hangs the request for the OS default, which is
# longer than every timeout in front of it.
DATABASE_POOL_CONNECT_TIMEOUT_MS=5000
# The web app's ceiling. The worker defaults to 120000 instead: a batch holds no browser
# open. Through the pooler this parameter is dropped, and migration 0022's role setting
# is what enforces it — see docs/scale/pgbouncer.md.
DATABASE_STATEMENT_TIMEOUT_MS=30000
# The nodes after node 0, in index order and contiguous — `DATABASE_SHARD_2_URL` with no
# shard 1 before it is a startup error, because the cluster indexes what it finds and a
# gap would put every tenant on node 2 in the wrong database. Absent is one node, which
# is every deployment until the split. There is no range here: `shard_assignments` on
# the catalog names the node, one row per tenant. Lite runs node 0 alone; adding a node
# is docs/scale/shard-nodes.md, and these lines are its shape.
# DATABASE_SHARD_1_URL=postgres://ratchet:ratchet@localhost:46433/ratchet
# DATABASE_SHARD_1_DIRECT_URL=postgres://ratchet:ratchet@localhost:45433/ratchet
# DATABASE_SHARD_1_REPLICA_URL=

# ── Redis ────────────────────────────────────────────────
# One instance, `noeviction`, because the queue must never lose a job. Two names anyway:
# splitting cache from queue is then these two lines — docs/scale/split-redis.md.
REDIS_PORT=46379
REDIS_CACHE_URL=redis://localhost:46379
REDIS_QUEUE_URL=redis://localhost:46379
# Live frames to open browser tabs. Unset, they ride the cache URL above; point it at
# another Redis once fan-out competes with every request's session reads.
# REDIS_REALTIME_URL=redis://localhost:46379

# ── Jobs ─────────────────────────────────────────────────
# Where a job goes. `bullmq` puts it on REDIS_QUEUE_URL for `pnpm dev:worker` to run.
# `cloudflare` posts it to the dispatcher Worker (apps/dispatcher), which calls back into
# the web app's /api/internal/job — the free-tier production shape, and how `wrangler dev`
# runs it locally. Both secrets: `openssl rand -hex 32`.
QUEUE_DRIVER=bullmq
# DISPATCHER_URL=http://localhost:8787
# DISPATCHER_SECRET=
# INTERNAL_JOB_SECRET=

# ── S3 / MinIO ───────────────────────────────────────────
# The console has no URL beside it — nothing in the app talks to it, you do.
S3_PORT=49000
MINIO_CONSOLE_PORT=49001
S3_ENDPOINT=http://localhost:49000
S3_REGION=us-east-1
S3_BUCKET=ratchet
S3_ACCESS_KEY=ratchet
S3_SECRET_KEY=ratchetsecret
# MinIO addresses buckets by path; real S3 addresses them by host. Unset defaults to
# `false`, which is the production answer — this line is here for the local stack.
S3_FORCE_PATH_STYLE=true
# `full` for MinIO and AWS. Backblaze B2: S3_CHECKSUMS=required and S3_LIFECYCLE=false, and
# turn on the bucket's default encryption (SSE-B2) and its lifecycle rule in the B2 console.
S3_CHECKSUMS=full
S3_LIFECYCLE=true

# ── Email ────────────────────────────────────────────────
# Mailpit, started by `pnpm infra:up`. It accepts everything, delivers nothing, and
# shows what it caught at http://localhost:48025 — which is where the verification link
# from a local sign-up turns up. Point this at your provider in every other environment;
# use `smtps://` for implicit TLS on 465.
SMTP_PORT=41025
MAILPIT_UI_PORT=48025
SMTP_URL=smtp://localhost:41025
# The envelope sender. Not defaulted anywhere in code on purpose: an address the sending
# domain does not authorise bounces or lands in spam, and it fails that way silently.
EMAIL_FROM=Wiremap <no-reply@localhost>
# The port `pnpm dev` serves on, read by apps/web/vite.config.ts. Three URLs restate it —
# APP_BASE_URL, AUTH_URL and the first entry of AUTH_TRUSTED_ORIGINS — and a sign-in
# fails in a way that names none of them if they drift, so §27 checks all three.
WEB_PORT=43000
# Seconds Nitro's Node server (srvx) gives in-flight requests after SIGTERM. The web app
# disposes its pools a second after this, so a request it let finish still has them.
SERVER_SHUTDOWN_TIMEOUT=5
# The origin a link inside a message points at. Separate from AUTH_URL, which is Better
# Auth's own: the worker renders the invitation link and parses no auth configuration.
# Mail only arrives while the worker is running — every send goes through the queue.
APP_BASE_URL=http://localhost:43000

# ── Auth ─────────────────────────────────────────────────
# Deliberately too short for the schema's `min(32)`: a placeholder that boots is one
# that reaches production. `openssl rand -base64 32` is the replacement.
AUTH_SECRET=change-me
AUTH_URL=http://localhost:43000
# Both Tauri origins are required — the webview scheme differs by platform
# (tauri://localhost on macOS/Linux, http://tauri.localhost on Windows).
# This same list drives the CORS allowlist on /api/rpc and /api/auth.
AUTH_TRUSTED_ORIGINS=http://localhost:43000,tauri://localhost,http://tauri.localhost

# How long a session is valid before it must be re-established. Slides on activity:
# Better Auth refreshes at a quarter of this value, so a session in daily use is not
# interrupted while an abandoned one still expires on schedule. 7 days.
AUTH_SESSION_MAX_AGE_SECONDS=604800
# **This is the revocation window, not a performance dial.** Signed session data lives in
# the cookie for this long, so a removed permission keeps working until it expires — the
# same ceiling the capability cache is held to. Sixty seconds, and no longer.
AUTH_COOKIE_CACHE_MAX_AGE_SECONDS=60
# Off only for local work. With it off, anyone can register under a colleague's address.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# What an authenticator app shows beside a TOTP code, and the product name on every
# transactional message. On the rename checklist in docs/setup/00 — changing it after
# anyone has enrolled leaves their authenticator naming a product that no longer exists.
AUTH_APP_NAME=Wiremap
# How a brand-new user acquires the membership without which no session is ever issued.
# One of three, and `Container` binds a different `MembershipEnroller` for each:
#
#   personal   They become the owner of an organization of their own, with the same four
#              system roles `pnpm db:seed` would have created. The default, and the only
#              mode that works against an empty database.
#   bootstrap  They join the one organization named below — first in as `owner`,
#              everyone after as `member`. Right for a demo or a single-tenant install,
#              and wrong for anything reachable from the internet: the sign-up form then
#              hands out membership of your tenant.
#   invite     They acquire none, and their first sign-in is refused. The production
#              posture: an invitation is the only door.
# Whatever the mode, an address with a pending invitation joins the organization that
# invited it *instead* — an invited person never gets a personal organization. Claims
# match against the verified address, so invitations need AUTH_REQUIRE_EMAIL_VERIFICATION.
AUTH_ENROLMENT_MODE=personal

# How many organizations one account may found. The 5/min rate limit on
# `/organization/create` bounds the rate and not the total, and each tenant seeds four
# roles and every permission in the registry — so a scripted client left overnight is a
# table nobody meant to fill. Raise it for a deployment where owning many is normal.
AUTH_MAX_OWNED_ORGANIZATIONS=10

# Read only under `AUTH_ENROLMENT_MODE=bootstrap`, and **required** there — the env
# schema refuses to boot without it rather than leaving a mode that silently enrols
# nobody. It is the same slug `pnpm db:seed` creates, so the two cannot drift.
BOOTSTRAP_ORGANIZATION_SLUG=loadbearing

# ── Google sign-in ───────────────────────────────────────
# Optional, and both halves or neither: the container only builds a provider when it has
# a complete pair, because a half-filled one is rejected at Google's consent screen —
# a failure the user sees and nobody can diagnose from the logs.
#
# Create an OAuth 2.0 **Web application** client in Google Cloud and give it this exact
# authorised redirect URI. Better Auth owns that path; nothing in apps/web routes it.
#
#   ${AUTH_URL}/api/auth/callback/google     — http://localhost:43000/api/auth/callback/google
#
# A Google sign-in matching an existing account is linked to it rather than refused:
# Google asserts a verified address, and it is on the trusted-provider list for exactly
# that reason. Every other flow works with these unset, and the button hides itself.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── GitHub sign-in ───────────────────────────────────────
# The GitHub App's OAuth credentials (docs/infra/github-app.md). Both or neither; the
# callback URL is ${AUTH_URL}/api/auth/callback/github.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── GitHub App (repositories) ────────────────────────────
# All four or none. The private key may be one line with \n escapes. Without them,
# projects take uploads from the CLI only. See docs/infra/github-app.md.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# ── Worker ───────────────────────────────────────────────
# How long `worker.close()` is given to drain in-flight jobs before the process exits
# anyway. Longer than your longest job, shorter than your orchestrator's SIGKILL timer.
WORKER_SHUTDOWN_TIMEOUT_MS=25000
# Per worker instance, never global. Four instances at concurrency 4 is sixteen
# in-flight jobs, each of which may hold a Postgres connection — keep
# concurrency x instances below your pool size.
WORKER_EMBEDDING_CONCURRENCY=4
# Serial by default. Maintenance jobs take table-level locks and run nightly; two
# overlapping buys nothing and can deadlock on the same partition.
WORKER_MAINTENANCE_CONCURRENCY=1
# Every message in this system is a job on this queue, so a stopped worker is a sign-up
# whose verification link never arrives.
WORKER_MAIL_CONCURRENCY=4
# The provider's cap, expressed once. Ten a second is under every managed sender's free
# tier; raising it above what your provider allows produces bounces, not throughput.
WORKER_MAIL_RATE_PER_MINUTE=600
# Outbox drain and delivery. Deliveries are subscriber work and fan out per event, so
# this is the highest of the five — the drain itself runs at priority 1 ahead of them.
WORKER_EVENT_CONCURRENCY=8

# The daily digest fan-out: one job a day, and each tenant's digest is I/O bound on the
# mail queue, which has its own limiter. Two is plenty.
WORKER_NOTIFICATION_CONCURRENCY=2

# ── Vectors ──────────────────────────────────────────────
# pgvector today. A dedicated vector database is one more value here and one more
# folder in packages/infrastructure/src — no call site changes, because
# `VectorStore.search()` already takes the resolved goal scope as a parameter rather
# than reaching for a CapabilitySet no remote store could hold.
VECTOR_DRIVER=pgvector

# ── AI / embeddings ──────────────────────────────────────
# `none` searches the text of each document chunk with Postgres full-text search: no key,
# no outbound call. `openai` or `gemini` embed through the provider and need the key.
# Switching provider or model leaves old vectors unread until `pnpm ai:reindex` runs —
# see packages/infrastructure/docs/reference/embedding.md.
EMBEDDING_PROVIDER=none
# EMBEDDING_API_KEY=
# Unset is the provider's default: text-embedding-3-small, or gemini-embedding-001.
# EMBEDDING_MODEL=
# Shared by both providers, and the width of the `vector(1536)` column: changing it is
# ALTER TABLE plus a re-embed of the whole corpus.
EMBEDDING_DIMENSIONS=1536

# ── Realtime ─────────────────────────────────────────────
# `none` publishes nothing and the browser polls (every 60 s, and when a tab comes back).
# `redis` is the kit's live stream, which needs a long-lived stream process — see
# docs/scale/realtime.md for bringing it back.
REALTIME_DRIVER=none
# Both are per process, not per cluster. The cap stops one runaway tab; a shared
# counter would cost a round trip on every stream open.
REALTIME_MAX_STREAMS_PER_USER=8
# A stream this old ends and the client reconnects, which releases a channel a
# leaked reader is holding. Thirty minutes.
REALTIME_STREAM_MAX_AGE_SECONDS=1800

# ── Logging ──────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# Human-shaped lines for a terminal. Never true in production — a collector wants
# one JSON object per line and nothing else.
LOG_PRETTY=false

# ── App ──────────────────────────────────────────────────
NODE_ENV=development
# APP and ENV are two of the four legal log labels. They identify the stream a
# line belongs to; everything higher-cardinality stays in the line body.
#
# `APP` is deliberately unset. Three processes read this one file, and each `env.ts`
# defaults it to its own name — `web`, `worker`, `realtime`. Pinning it globally makes
# every worker line claim to come from the web app, which is the label you filter on.
ENV=development
